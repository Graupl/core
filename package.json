{
  "name": "@graupl/core",
  "version": "1.0.0-beta.59",
  "license": "GPL-3.0-or-later",
  "description": "The core module of Graupl, providing essential styles and utilities.",
  "main": "dist/js/graupl.cjs",
  "module": "dist/js/graupl.es.js",
  "type": "module",
  "files": [
    "dist",
    "scss",
    "src"
  ],
  "exports": {
    ".": {
      "sass": "./scss/graupl.scss",
      "import": "./dist/js/graupl.es.js",
      "require": "./dist/js/graupl.cjs"
    },
    "./*.scss": {
      "sass": "./scss/*.scss"
    },
    "./src/*.scss": {
      "sass": "./src/scss/*.scss"
    },
    "./src/*.js": {
      "import": "./src/js/*.js"
    },
    "./accordion": {
      "import": "./dist/js/component/accordion.es.js",
      "require": "./dist/js/component/accordion.cjs"
    },
    "./accordion/generator": {
      "import": "./dist/js/generator/accordion.es.js",
      "require": "./dist/js/generator/accordion.cjs"
    },
    "./alert": {
      "import": "./dist/js/component/alert.es.js",
      "require": "./dist/js/component/alert.cjs"
    },
    "./alert/generator": {
      "import": "./dist/js/generator/alert.es.js",
      "require": "./dist/js/generator/alert.cjs"
    },
    "./breadcrumb": {
      "import": "./dist/js/component/breadcrumb.es.js",
      "require": "./dist/js/component/breadcrumb.cjs"
    },
    "./breadcrumb/generator": {
      "import": "./dist/js/generator/breadcrumb.es.js",
      "require": "./dist/js/generator/breadcrumb.cjs"
    },
    "./carousel": {
      "import": "./dist/js/component/carousel.es.js",
      "require": "./dist/js/component/carousel.cjs"
    },
    "./carousel/generator": {
      "import": "./dist/js/generator/carousel.es.js",
      "require": "./dist/js/generator/carousel.cjs"
    },
    "./disclosure": {
      "import": "./dist/js/component/disclosure.es.js",
      "require": "./dist/js/component/disclosure.cjs"
    },
    "./disclosure/generator": {
      "import": "./dist/js/generator/disclosure.es.js",
      "require": "./dist/js/generator/disclosure.cjs"
    },
    "./navigation/generator": {
      "import": "./dist/js/generator/navigation.es.js",
      "require": "./dist/js/generator/navigation.cjs"
    },
    "./tabs": {
      "import": "./dist/js/component/tabs.es.js",
      "require": "./dist/js/component/tabs.cjs"
    },
    "./tabs/generator": {
      "import": "./dist/js/generator/tabs.es.js"
    },
    "./tooltip": {
      "import": "./dist/js/component/tooltip.es.js",
      "require": "./dist/js/component/tooltip.cjs"
    },
    "./tooltip/generator": {
      "import": "./dist/js/generator/tooltip.es.js",
      "require": "./dist/js/generator/tooltip.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Graupl/core.git"
  },
  "keywords": [
    "graupl"
  ],
  "author": "Nick Milton",
  "contributors": [
    {
      "name": "Coldfront Labs Inc.",
      "url": "https://coldfrontlabs.ca"
    }
  ],
  "bugs": {
    "url": "https://github.com/Graupl/core/issues"
  },
  "homepage": "https://github.com/Graupl/core#readme",
  "scripts": {
    "presass": "rm -rf dist/css/*",
    "precss": "rm -rf dist/css/*",
    "sass": "sass scss:dist/css --pkg-importer=node",
    "css": "node compile-styles.js",
    "prerolldown": "rm -rf dist/js/*",
    "rolldown": "rolldown --config ./rolldown.config.js",
    "build": "npm-run-all build:*",
    "build:css": "npm run css",
    "build:js": "npm run rolldown",
    "eslint": "eslint .",
    "stylelint": "stylelint '**/*.scss' --allow-empty-input",
    "prettier": "prettier '**/*.{js,mjs,cjs,scss,sass}'",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "pretest:browser": "npm run build:css",
    "prepare": "husky",
    "commit": "git cz",
    "lint": "npm run eslint -- --fix && npm run stylelint -- --fix && npm run prettier --  --write",
    "release": "commit-and-tag-version -a",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@accessible-ecosystem/core": "^1.0.0-beta.14",
    "@drupal/once": "git+https://git.drupalcode.org/issue/once-3466026.git#1ae06384d98d4c70c1e3ef5550ac7559e18e2342"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "@eslint/js": "9.39.5",
    "@rollup/plugin-babel": "6.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/ui": "4.1.10",
    "commit-and-tag-version": "^12.5.1",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-jsdoc": "50.8.0",
    "globals": "15.15.0",
    "husky": "^9.0.11",
    "jsdom": "27.4.0",
    "lightningcss": "1.33.0",
    "lint-staged": "^15.2.2",
    "npm-run-all": "4.1.5",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "rolldown": "1.2.4",
    "rollup-plugin-esbuild": "6.2.1",
    "sass": "1.102.0",
    "sass-embedded": "1.100.0",
    "stylelint": "16.26.1",
    "stylelint-config-property-sort-order-smacss": "10.0.0",
    "stylelint-config-sass-guidelines": "12.1.0",
    "stylelint-config-standard-scss": "13.1.0",
    "stylelint-prettier": "5.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vitest-browser-vue": "2.1.0",
    "vue": "3.5.45"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
